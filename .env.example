# ============================================================================
# CRYPT0XDEV - ENVIRONMENT VARIABLES
# ============================================================================
# Copia este archivo a .env y configura tus valores personales
# NUNCA subas el archivo .env a Git (ya está en .gitignore)

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
# URL pública del sitio (sin barra final)
PUBLIC_SITE_URL=https://crypt0xdev.com

# Título del sitio
PUBLIC_SITE_TITLE=Crypt0xDev

# Email de contacto
PUBLIC_CONTACT_EMAIL=contact@crypt0xdev.com

# ============================================================================
# SUPABASE — BASE DE DATOS · AUTH · STORAGE (fotos/PDF)
# ============================================================================
# Valores del panel de Supabase:  Project Settings → API
#
# URL del proyecto y clave "anon" — PÚBLICAS (se usan en el navegador).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
#
# Clave "service_role" — ⚠️ SECRETA. Solo en el servidor (panel/migración).
# NUNCA la pongas en variables PUBLIC_* ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=
#
# Nombre del bucket de Storage para imágenes/PDF (créalo en Storage).
PUBLIC_SUPABASE_STORAGE_BUCKET=media

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Google Analytics (opcional)
PUBLIC_GA_TRACKING_ID=

# Vercel Analytics (ya integrado en el proyecto)
# No requiere configuración adicional si estás en Vercel

# Plausible Analytics (alternativa privacy-friendly)
PUBLIC_PLAUSIBLE_DOMAIN=

# ============================================================================
# SENTRY - ERROR TRACKING
# ============================================================================
# DSN de Sentry para tracking de errores
SENTRY_DSN=

# Auth token para source maps (solo en producción)
SENTRY_AUTH_TOKEN=

# Proyecto de Sentry
SENTRY_PROJECT=crypt0xdev

# Organización de Sentry
SENTRY_ORG=

# ============================================================================
# SEARCH - PAGEFIND
# ============================================================================
# Pagefind es self-hosted, no requiere API key
# Configuración adicional si usas Algolia u otro servicio

# Algolia (alternativa)
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_API_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=

# ============================================================================
# CMS - TINA CMS / STRAPI (OPCIONAL)
# ============================================================================
# Si decides implementar un CMS headless

# Tina Cloud
TINA_CLIENT_ID=
TINA_TOKEN=

# Strapi
STRAPI_API_URL=
STRAPI_API_TOKEN=

# ============================================================================
# SOCIAL MEDIA
# ============================================================================
# Handles de redes sociales (sin @)
PUBLIC_TWITTER_HANDLE=crypt0xdev
PUBLIC_GITHUB_USERNAME=Crypt0xDev
PUBLIC_LINKEDIN_USERNAME=

# ============================================================================
# API INTEGRATIONS
# ============================================================================
# HackTheBox API (para estadísticas automáticas)
HTB_API_KEY=

# TryHackMe API
THM_API_KEY=

# ============================================================================
# EMAIL SERVICE (para formulario de contacto)
# ============================================================================
# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend (alternativa moderna)
RESEND_API_KEY=

# ============================================================================
# CDN & STORAGE
# ============================================================================
# Cloudinary (para imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (alternativa)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ============================================================================
# BUILD & DEPLOYMENT
# ============================================================================
# Entorno actual (development, production)
NODE_ENV=development

# Puerto del servidor de desarrollo
PORT=4321

# ============================================================================
# SECURITY
# ============================================================================
# Secret para tokens JWT (si implementas auth)
JWT_SECRET=

# API rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
