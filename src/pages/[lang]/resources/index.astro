---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { useTranslations } from '@i18n/core';
import { filterByLang } from '@i18n/utils';
import { RESOURCE_CATEGORIES } from '@i18n/constants/resources';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

// Obtener todos los recursos
const allResources = await getCollection('resources');

// Filtrar por idioma basado en el slug (es/category/file o en/category/file)
const resources = allResources.filter((r) => {
  const idParts = r.id.replace(/\.md$/, '').split('/');
  const resourceLang =
    idParts[0] === 'es' || idParts[0] === 'en' ? idParts[0] : 'es';
  return resourceLang === lang;
});

// Contar recursos por categoría usando la configuración centralizada
const categoryCounts = RESOURCE_CATEGORIES.map((category) => {
  const categorySlug = category.id;
  const count = resources.filter((r) => {
    const idParts = r.id.replace(/\.md$/, '').split('/');
    const resourceCategory =
      idParts[0] === 'es' || idParts[0] === 'en' ? idParts[1] : idParts[0];
    return resourceCategory === categorySlug;
  }).length;

  return {
    ...category,
    name: category.name[lang as 'es' | 'en'],
    description: category.description[lang as 'es' | 'en'],
    count,
  };
});

// Mapeo de IDs a rutas de carpetas
const categoryRoutes: { [key: string]: string } = {
  tools: 'tools',
  cheatsheets: 'cheatsheets',
  labs: 'labs',
  videos: 'videos',
  challenges: 'challenges',
  projects: 'projects',
  vulnerabilities: 'vulnerabilities',
};

// Recursos recientes (últimos 6 por orden alfabético)
const recentResources = resources.slice(0, 6);
---

<Layout
  title={lang === 'es' ? 'Recursos - Crypt0xDev' : 'Resources - Crypt0xDev'}
  description={lang === 'es'
    ? 'Recursos, herramientas, guías y materiales para aprender ciberseguridad y hacking ético'
    : 'Resources, tools, guides and materials to learn cybersecurity and ethical hacking'}
  lang={lang}
>
  <main
    class="min-h-[calc(100vh-16rem)] bg-linear-to-br from-white via-white to-blue-50/20 dark:from-slate-900 dark:via-slate-900 dark:to-blue-950/10"
  >
    <section class="py-12 md:py-16">
      <div class="container max-w-7xl mx-auto px-4">
        <Breadcrumb
          items={[
            { label: lang === 'es' ? 'Inicio' : 'Home', href: `/${lang}` },
            { label: lang === 'es' ? 'Recursos' : 'Resources' },
          ]}
        />

        <div class="mb-12">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 rounded-full text-sm font-semibold mb-6"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
              ><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path
                d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
              ></path></svg
            >
            {
              lang === 'es'
                ? 'Recursos de Ciberseguridad'
                : 'Cybersecurity Resources'
            }
          </div>
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 font-sans tracking-tight bg-linear-to-r from-slate-900 via-blue-600 to-slate-900 dark:from-slate-100 dark:via-blue-400 dark:to-slate-100 bg-clip-text text-transparent"
          >
            {lang === 'es' ? 'Recursos' : 'Resources'}
          </h1>
          <div class="max-w-3xl">
            <p
              class="text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed mb-6"
            >
              {
                lang === 'es'
                  ? 'Herramientas, guías, tutoriales y recursos esenciales para tu camino en ciberseguridad. Cheatsheets, labs, videos, proyectos y más.'
                  : 'Tools, guides, tutorials and essential resources for your cybersecurity journey. Cheatsheets, labs, videos, projects and more.'
              }
            </p>

            <!-- Stats Grid -->
            <div class="grid grid-cols-3 gap-4 mb-8">
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-blue-600 dark:text-blue-400"
                >
                  {resources.length}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Recursos' : 'Resources'}
                </div>
              </div>
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-blue-600 dark:text-blue-400"
                >
                  {RESOURCE_CATEGORIES.length}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Categorías' : 'Categories'}
                </div>
              </div>
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-blue-600 dark:text-blue-400"
                >
                  {categoryCounts.reduce((acc, cat) => acc + cat.count, 0)}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Items' : 'Items'}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Categories Grid -->
        <div class="mb-8">
          <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">
            {lang === 'es' ? 'Explorar Categorías' : 'Explore Categories'}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          {
            categoryCounts.map((category) => (
              <a
                href={`/${lang}/resources/${category.id}`}
                class={`group relative overflow-hidden rounded-2xl border-2 ${category.borderColor} ${category.bgColor} p-6 transition-all duration-300 hover:scale-105 hover:shadow-2xl`}
              >
                <div class="relative z-10">
                  <div class="w-16 h-16 mb-4 flex items-center justify-center bg-white/50 dark:bg-slate-800/50 rounded-xl">
                    <span
                      class="[&>svg]:w-10 [&>svg]:h-10"
                      set:html={category.icon}
                    />
                  </div>
                  <h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
                    {category.name}
                  </h3>
                  <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 line-clamp-2">
                    {category.description}
                  </p>
                  <div class="flex items-center justify-between">
                    <span
                      class={`text-sm font-semibold bg-linear-to-r ${category.gradient} bg-clip-text text-transparent`}
                    >
                      {category.count}{' '}
                      {lang === 'es'
                        ? category.count === 1
                          ? 'recurso'
                          : 'recursos'
                        : category.count === 1
                          ? 'resource'
                          : 'resources'}
                    </span>
                    <svg
                      class="w-5 h-5 text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </div>
                </div>
                <div
                  class={`absolute inset-0 bg-linear-to-br ${category.gradient} opacity-0 group-hover:opacity-5 transition-opacity duration-300`}
                />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      resources.length === 0 && (
        <section class="py-16">
          <div class="container max-w-7xl mx-auto px-4">
            <div class="text-center py-16 bg-white dark:bg-slate-800 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700">
              <div class="[&>svg]:w-14 [&>svg]:h-14 text-slate-400 dark:text-slate-600 mb-4 flex justify-center">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <>
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                  </>
                </svg>
              </div>
              <h3 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white">
                {lang === 'es' ? 'Próximamente' : 'Coming Soon'}
              </h3>
              <p class="text-slate-600 dark:text-slate-400">
                {lang === 'es'
                  ? 'Estamos preparando recursos. ¡Vuelve pronto!'
                  : 'We are preparing resources. Come back soon!'}
              </p>
            </div>
          </div>
        </section>
      )
    }
  </main>
</Layout>
