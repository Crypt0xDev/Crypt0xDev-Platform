---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { getLangFromUrl, useTranslations } from '@i18n/core';
import { PLATFORMS, getAllPlatforms } from '@i18n/constants/platforms';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

// Obtener parámetros de filtro de la URL
const url = Astro.url;
const filterType = url.searchParams.get('filter'); // attackVector, technique, certification, vulnerability
const filterValue = url.searchParams.get('value');

// Platform information (usando configuración centralizada)
const platforms = getAllPlatforms().map((p) => ({
  name: p.name,
  slug: p.slug,
  platformId: p.id,
  description: p.description,
  color: p.color.gradient,
  bgColor:
    p.id === 'htb'
      ? 'bg-green-50 dark:bg-green-950/20'
      : p.id === 'tryhackme'
        ? 'bg-red-50 dark:bg-red-950/20'
        : p.id === 'hackmyvm'
          ? 'bg-blue-50 dark:bg-blue-950/20'
          : p.id === 'vulnhub'
            ? 'bg-purple-50 dark:bg-purple-950/20'
            : 'bg-orange-50 dark:bg-orange-950/20',
  borderColor:
    p.id === 'htb'
      ? 'border-green-200 dark:border-green-900'
      : p.id === 'tryhackme'
        ? 'border-red-200 dark:border-red-900'
        : p.id === 'hackmyvm'
          ? 'border-blue-200 dark:border-blue-900'
          : p.id === 'vulnhub'
            ? 'border-purple-200 dark:border-purple-900'
            : 'border-orange-200 dark:border-orange-900',
  href: `/${lang}/writeup/${p.slug}`,
  logo: 'logo' in p ? p.logo : undefined,
  icon: p.icon,
}));

// Get all writeups
const allWriteups = await getCollection('writeups', (writeup) => {
  return writeup.id.startsWith(`${lang}/`);
});

// Aplicar filtros si existen
let filteredWriteups = allWriteups;
if (filterType && filterValue) {
  filteredWriteups = allWriteups.filter((w) => {
    switch (filterType) {
      case 'attackVector':
        return w.data.attackVectors?.some((v) => v === filterValue);
      case 'technique':
        return w.data.techniques?.some((t) => t === filterValue);
      case 'certification':
        return w.data.certifications?.some((c) => c === filterValue);
      case 'vulnerability':
        return w.data.vulnerabilities?.some((vuln) => vuln === filterValue);
      case 'tag':
        return w.data.tags?.some((tag) => tag === filterValue);
      default:
        return true;
    }
  });
}

// Difficulty counts per platform
const getDifficultyCounts = (
  platformId: string,
  writeupList: typeof allWriteups
) => ({
  easy: writeupList.filter(
    (w) => w.data.platform === platformId && w.data.difficulty === 'easy'
  ).length,
  medium: writeupList.filter(
    (w) => w.data.platform === platformId && w.data.difficulty === 'medium'
  ).length,
  hard: writeupList.filter(
    (w) => w.data.platform === platformId && w.data.difficulty === 'hard'
  ).length,
  insane: writeupList.filter(
    (w) => w.data.platform === platformId && w.data.difficulty === 'insane'
  ).length,
});

// Count writeups per platform (usando filteredWriteups si hay filtro)
const platformCounts = platforms.map((platform) => ({
  ...platform,
  count: (filterType ? filteredWriteups : allWriteups).filter(
    (w) => w.data.platform === platform.platformId
  ).length,
  difficulties: getDifficultyCounts(
    platform.platformId,
    filterType ? filteredWriteups : allWriteups
  ),
}));

// Traducciones para filtros
const filterTranslations = {
  attackVector: { es: 'Vector de Ataque', en: 'Attack Vector' },
  technique: { es: 'Técnica MITRE', en: 'MITRE Technique' },
  certification: { es: 'Certificación', en: 'Certification' },
  vulnerability: { es: 'Vulnerabilidad', en: 'Vulnerability' },
  tag: { es: 'Etiqueta', en: 'Tag' },
};
---

<Layout title={`${lang === 'es' ? 'Writeups' : 'Writeups'}`}>
  <main
    class="min-h-[calc(100vh-16rem)] bg-linear-to-br from-white via-white to-indigo-50/20 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950/10"
  >
    <!-- Banner de filtro activo -->
    {
      filterType && filterValue && (
        <div class="bg-linear-to-r from-indigo-600 to-purple-600 dark:from-indigo-800 dark:to-purple-800 py-4">
          <div class="container max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between flex-wrap gap-4">
              <div class="flex items-center gap-3">
                <span class="text-white text-sm font-semibold">
                  {lang === 'es' ? 'Filtrando por' : 'Filtering by'}:
                </span>
                <span class="px-4 py-2 bg-white/20 backdrop-blur-sm border border-white/30 rounded-full text-white font-bold text-sm">
                  {
                    filterTranslations[
                      filterType as keyof typeof filterTranslations
                    ][lang as 'es' | 'en']
                  }
                  : {filterValue}
                </span>
                <span class="text-white/80 text-sm">
                  ({filteredWriteups.length}{' '}
                  {lang === 'es' ? 'resultados' : 'results'})
                </span>
              </div>
              <a
                href={`/${lang}/writeup`}
                class="px-4 py-2 bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/30 rounded-full text-white font-semibold text-sm transition-all duration-200 hover:scale-105"
              >
                {lang === 'es' ? '× Limpiar filtro' : '× Clear filter'}
              </a>
            </div>
          </div>
        </div>
      )
    }

    <!-- Hero Section -->
    <section class="py-12 md:py-16">
      <div class="container max-w-7xl mx-auto px-4">
        <!-- Breadcrumb -->
        <Breadcrumb
          items={[
            { label: lang === 'es' ? 'Inicio' : 'Home', href: `/${lang}` },
            { label: 'Writeups' },
          ]}
        />

        <div class="mb-12">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full text-sm font-semibold mb-6"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
              ></path>
            </svg>
            {lang === 'es' ? 'Plataformas de Hacking' : 'Hacking Platforms'}
          </div>
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 font-sans tracking-tight bg-linear-to-r from-slate-900 via-indigo-600 to-slate-900 dark:from-slate-100 dark:via-indigo-400 dark:to-slate-100 bg-clip-text text-transparent"
          >
            {
              filterType
                ? lang === 'es'
                  ? 'Resultados de Búsqueda'
                  : 'Search Results'
                : 'Writeups'
            }
          </h1>
          <div class="max-w-3xl">
            <p
              class="text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed mb-6"
            >
              {
                lang === 'es'
                  ? 'Bienvenido a la sección de writeups, aquí vas a encontrar resoluciones de máquinas, tanto escritas como en formato video, de plataformas como HackTheBox, TryHackMe, HackMyVM y VulnHub.'
                  : 'Welcome to the writeups section, here you will find machine solutions, both written and in video format, from platforms such as HackTheBox, TryHackMe, HackMyVM and VulnHub.'
              }
            </p>

            <!-- Stats Grid -->
            <div class="grid grid-cols-3 gap-4 mb-8">
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"
                >
                  {allWriteups.length}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Writeups' : 'Writeups'}
                </div>
              </div>
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"
                >
                  {platformCounts.filter((p) => p.count > 0).length}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Plataformas' : 'Platforms'}
                </div>
              </div>
              <div
                class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700"
              >
                <div
                  class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"
                >
                  {platforms.length}
                </div>
                <div class="text-sm text-slate-600 dark:text-slate-400">
                  {lang === 'es' ? 'Categorías' : 'Categories'}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Platform Cards Grid -->
        <div class="mb-8">
          <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">
            {lang === 'es' ? 'Plataformas' : 'Platforms'}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
          {
            platformCounts.map((platform) => (
              <a
                href={platform.href}
                class="group relative overflow-hidden rounded-2xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:border-indigo-500 dark:hover:border-indigo-500"
              >
                <div class="relative z-10">
                  <div class="w-16 h-16 mb-4 flex items-center justify-center bg-slate-50 dark:bg-slate-700/50 rounded-xl p-2">
                    {platform.logo ? (
                      <img
                        src={platform.logo}
                        alt={platform.name}
                        class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110"
                      />
                    ) : (
                      <span
                        class="[&>svg]:w-10 [&>svg]:h-10"
                        set:html={platform.icon}
                      />
                    )}
                  </div>
                  <h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                    {platform.name}
                  </h3>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                      {platform.count} writeup{platform.count !== 1 ? 's' : ''}
                    </span>
                    <svg
                      class="w-5 h-5 text-slate-400 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </div>

                  {platform.count > 0 && (
                    <div class="flex flex-wrap gap-1 mt-3">
                      {platform.difficulties.easy > 0 && (
                        <span class="text-xs px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full">
                          {platform.difficulties.easy}{' '}
                          {lang === 'es' ? 'fácil' : 'easy'}
                        </span>
                      )}
                      {platform.difficulties.medium > 0 && (
                        <span class="text-xs px-2 py-1 bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 rounded-full">
                          {platform.difficulties.medium}{' '}
                          {lang === 'es' ? 'medio' : 'medium'}
                        </span>
                      )}
                      {platform.difficulties.hard > 0 && (
                        <span class="text-xs px-2 py-1 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-full">
                          {platform.difficulties.hard}{' '}
                          {lang === 'es' ? 'difícil' : 'hard'}
                        </span>
                      )}
                      {platform.difficulties.insane > 0 && (
                        <span class="text-xs px-2 py-1 bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 rounded-full">
                          {platform.difficulties.insane} insane
                        </span>
                      )}
                    </div>
                  )}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
