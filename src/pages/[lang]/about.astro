---
import Layout from '@layouts/Layout.astro';
import Breadcrumb from '@components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '@i18n/core';
import { filterByLang } from '@i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

const allWriteups = await getCollection('writeups');
const allBlog = await getCollection('blog');
const allCtf = await getCollection('ctf');

const writeups = filterByLang(allWriteups, lang as string);
const blog = filterByLang(allBlog, lang as string);
const ctf = filterByLang(allCtf, lang as string);

const platforms = {
  htb: writeups.filter((w) => w.data.platform === 'htb').length,
  tryhackme: writeups.filter((w) => w.data.platform === 'tryhackme').length,
  vulnhub: writeups.filter((w) => w.data.platform === 'vulnhub').length,
  hackmyvm: writeups.filter((w) => w.data.platform === 'hackmyvm').length,
};

const totalPlatforms = Object.values(platforms).filter((v) => v > 0).length;
---

<Layout
  title={t('nav.about')}
  description="About Crypt0xDev - Cybersecurity Blog"
  lang={lang}
>
  <main
    class="min-h-[calc(100vh-16rem)] bg-linear-to-br from-white via-white to-indigo-50/20 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950/10"
  >
    <!-- Animated Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div
        class="absolute top-1/4 -left-1/4 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-1/4 -right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
    </div>

    <section class="py-12 md:py-16">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb
          items={[
            { label: lang === 'es' ? 'Inicio' : 'Home', href: `/${lang}` },
            { label: lang === 'es' ? 'Acerca de' : 'About' },
          ]}
        />

        <!-- Hero -->
        <div class="mb-12">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 rounded-full text-sm font-semibold mb-6"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg
            >
            {lang === 'es' ? 'Acerca de' : 'About'}
          </div>
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 font-sans tracking-tight bg-linear-to-r from-slate-900 via-indigo-600 to-slate-900 dark:from-slate-100 dark:via-indigo-400 dark:to-slate-100 bg-clip-text text-transparent"
          >
            @Crypt0xDev
          </h1>
          <p
            class="text-lg md:text-xl text-slate-700 dark:text-slate-300 leading-relaxed mb-6 max-w-3xl"
          >
            {
              lang === 'es'
                ? 'Security researcher, developer y creador de contenido de ciberseguridad.'
                : 'Security researcher, developer and cybersecurity content creator.'
            }
          </p>

          <!-- Stats inline -->
          <div class="grid grid-cols-4 gap-4 mb-8 max-w-lg">
            <div
              class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 text-center"
            >
              <div
                class="text-3xl font-bold text-indigo-600 dark:text-indigo-400"
              >
                {writeups.length}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                Writeups
              </div>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 text-center"
            >
              <div
                class="text-3xl font-bold text-purple-600 dark:text-purple-400"
              >
                {blog.length}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                Posts
              </div>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 text-center"
            >
              <div class="text-3xl font-bold text-red-600 dark:text-red-400">
                {ctf.length}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                CTF
              </div>
            </div>
            <div
              class="bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 text-center"
            >
              <div class="text-3xl font-bold text-cyan-600 dark:text-cyan-400">
                {totalPlatforms}
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400 mt-1">
                {lang === 'es' ? 'Plataformas' : 'Platforms'}
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="flex gap-3">
            <a
              href="https://github.com/Crypt0xDev"
              target="_blank"
              rel="noopener noreferrer"
              class="group p-3 bg-slate-100 dark:bg-slate-800 hover:bg-indigo-500 dark:hover:bg-indigo-600 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50"
              aria-label="GitHub"
            >
              <svg
                class="w-5 h-5 text-slate-700 dark:text-slate-300 group-hover:text-white transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </a>
            <a
              href="https://twitter.com/Crypt0xDev"
              target="_blank"
              rel="noopener noreferrer"
              class="group p-3 bg-slate-100 dark:bg-slate-800 hover:bg-indigo-500 dark:hover:bg-indigo-600 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-indigo-500/50"
              aria-label="Twitter / X"
            >
              <svg
                class="w-5 h-5 text-slate-700 dark:text-slate-300 group-hover:text-white transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.youtube.com/@Crypt0xDev"
              target="_blank"
              rel="noopener noreferrer"
              class="group p-3 bg-slate-100 dark:bg-slate-800 hover:bg-red-500 dark:hover:bg-red-600 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-red-500/50"
              aria-label="YouTube"
            >
              <svg
                class="w-5 h-5 text-slate-700 dark:text-slate-300 group-hover:text-white transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                ></path>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/crypt0xdev"
              target="_blank"
              rel="noopener noreferrer"
              class="group p-3 bg-slate-100 dark:bg-slate-800 hover:bg-pink-500 dark:hover:bg-pink-600 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-pink-500/50"
              aria-label="Instagram"
            >
              <svg
                class="w-5 h-5 text-slate-700 dark:text-slate-300 group-hover:text-white transition-colors"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Info Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Quién Soy -->
          <div
            class="group relative overflow-hidden rounded-2xl border-2 border-indigo-200 dark:border-indigo-800 bg-indigo-50/50 dark:bg-indigo-950/10 p-6 transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl"
          >
            <div class="relative z-10">
              <div
                class="w-14 h-14 mb-4 flex items-center justify-center bg-white/50 dark:bg-slate-800/50 rounded-xl"
              >
                <svg
                  class="w-7 h-7 text-indigo-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                  ></path></svg
                >
              </div>
              <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
                {lang === 'es' ? 'Quién Soy' : 'Who I Am'}
              </h2>
              <p
                class="text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed"
              >
                {
                  lang === 'es'
                    ? 'Estudiante de Ingeniería en Sistemas especializado en ciberseguridad. Apasionado por encontrar vulnerabilidades, entender sistemas y crear herramientas de seguridad.'
                    : 'Systems Engineering student specialized in cybersecurity. Passionate about finding vulnerabilities, understanding systems and creating security tools.'
                }
              </p>
              <div class="flex flex-col gap-1.5 text-sm">
                <span
                  class="flex items-center gap-2 text-indigo-600 dark:text-indigo-400 font-medium"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><circle cx="12" cy="12" r="3"></circle><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                    ></path></svg
                  >
                  WiFi Security · Web AppSec · Pentesting Tools
                </span>
                <span
                  class="flex items-center gap-2 text-purple-600 dark:text-purple-400 font-medium"
                >
                  <svg
                    class="w-4 h-4 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5"
                    ></path></svg
                  >
                  eJPT → OSCP
                </span>
              </div>
            </div>
            <div
              class="absolute inset-0 bg-linear-to-br from-indigo-500 to-purple-600 opacity-0 group-hover:opacity-5 transition-opacity duration-300"
            >
            </div>
          </div>

          <!-- La Plataforma -->
          <div
            class="group relative overflow-hidden rounded-2xl border-2 border-blue-200 dark:border-blue-800 bg-blue-50/50 dark:bg-blue-950/10 p-6 transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl"
          >
            <div class="relative z-10">
              <div
                class="w-14 h-14 mb-4 flex items-center justify-center bg-white/50 dark:bg-slate-800/50 rounded-xl"
              >
                <svg
                  class="w-7 h-7 text-blue-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
                  ></path></svg
                >
              </div>
              <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
                {lang === 'es' ? 'La Plataforma' : 'The Platform'}
              </h2>
              <p
                class="text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed"
              >
                {
                  lang === 'es'
                    ? 'Hub centralizado de contenido técnico en español e inglés. Writeups de HTB, TryHackMe, VulnHub, CTFs, blog de investigación y recursos de aprendizaje.'
                    : 'Centralized hub for technical content in Spanish and English. Writeups from HTB, TryHackMe, VulnHub, CTFs, research blog and learning resources.'
                }
              </p>
              <span
                class="flex items-center gap-2 text-sm text-cyan-600 dark:text-cyan-400 font-medium"
              >
                <svg
                  class="w-4 h-4 shrink-0"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  ><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg
                >
                Astro 6 + TypeScript · Tailwind 4 · Lighthouse 100/100
              </span>
            </div>
            <div
              class="absolute inset-0 bg-linear-to-br from-blue-500 to-cyan-600 opacity-0 group-hover:opacity-5 transition-opacity duration-300"
            >
            </div>
          </div>

          <!-- Portfolio -->
          <div
            class="group relative overflow-hidden rounded-2xl border-2 border-purple-200 dark:border-purple-800 bg-purple-50/50 dark:bg-purple-950/10 p-6 transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl md:col-span-2"
          >
            <div class="relative z-10">
              <div
                class="w-14 h-14 mb-4 flex items-center justify-center bg-white/50 dark:bg-slate-800/50 rounded-xl"
              >
                <svg
                  class="w-7 h-7 text-purple-500"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l5.654-4.654m5.58-5.58 4.243-4.243a1 1 0 0 1 1.414 1.414l-4.243 4.243m-5.58 5.58L8.19 8.19m3.23 6.98L8.19 8.19m3.23 6.98a2.652 2.652 0 1 1-3.586-3.586L8.19 8.19"
                  ></path></svg
                >
              </div>
              <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
                {
                  lang === 'es'
                    ? 'Proyectos & Herramientas'
                    : 'Projects & Tools'
                }
              </h2>
              <p
                class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed"
              >
                {
                  lang === 'es'
                    ? 'Desarrollo frameworks de pentesting, plataformas educativas y herramientas open-source. Comparto writeups detallados, tutoriales prácticos y análisis de herramientas para ayudar a otros a aprender pentesting de forma efectiva.'
                    : 'I develop pentesting frameworks, educational platforms and open-source tools. I share detailed writeups, practical tutorials and tool analysis to help others learn pentesting effectively.'
                }
              </p>
            </div>
            <div
              class="absolute inset-0 bg-linear-to-br from-purple-500 to-pink-600 opacity-0 group-hover:opacity-5 transition-opacity duration-300"
            >
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
